# ======================================================================================================================
#
# 以下是挑战组和挑战设置的格式与说明单注释 (#) 是最常用的设置，双注释 (##) 是可选设置，如果你喜欢使用这些设置的话
#
# 物品类型格式
# 物品类型定义方式与 Minecraft /give 命令相同，即使用它们的 Minecraft 键以及可能的组件，放入方括号中
# 例如，'minecraft:diamond_sword[damage=42]'请参阅 Minecraft Wiki 了解更多信息：
# https://minecraft.wiki/w/Data_component_format你也可以使用命令 '/usb iteminfo' 来获取信息
#
# 此物品类型根据使用位置的不同，会补充额外的信息：
#
# display-item: <类型>
# 要在 GUI 中显示的物品它仅定义如上所述的物品类型，不带任何额外信息
# 例如：'cobblestone', 'minecraft:stone', 'diamond_sword[damage=42]'
#
# item-requirement: <类型>:<数量>[;+<增量>]
# 挑战的物品需求数量是所需的物品数量可选的 +<数量> 是每次重复挑战时所需物品增加的数量
# 例如，'cobblestone:64;+16' 第一次完成需要 64 个圆石，第二次完成需要 80 个圆石其他选项是
# -、* 和 /，分别用于减法、乘法和除法例如，'cobblestone:64;*2' 第一次完成
# 需要 64 个圆石，第二次完成需要 128 个圆石，第三次完成需要 256 个圆石
#
# item-reward: [{p=<概率>}]<类型>:<数量>
# 挑战的物品奖励数量是要给予的物品数量可选的 {p=<概率>} 是
# 给予该物品的概率例如，'cobblestone:64' 每次完成挑战都会给予 64 个圆石，
# 而 '{p=0.1}cobblestone:64' 有 10% 的概率给予 64 个圆石
#
# ======================================================================================================================
# 所有挑战都在 ranks 部分中定义每个 rank 是玩家可以完成的一层挑战
#
# ranks:
#  # [文本] 挑战等级的名称
#  TierX:
#    # [文本] 执行 /challenges 时显示的挑战等级名称（支持大写和颜色代码）
#    name: '&a自定义挑战等级名称'
#    # [display-item] 在挑战菜单中为已完成挑战显示的物品
#    displayItem: 'cyan_terracotta'
#    # [整数] 需求物品重置为默认值之前的时间（小时）（这将覆盖主要的重置时间）
#    resetInHours: 20
#    # 这些需求控制挑战组何时对玩家可用
#    requires:
#      # [整数] 每个等级可以未完成但能晋级到下一个等级的挑战数量例如，
#                 如果你有 4 个挑战且 rankLeeway 为 1，玩家只需完成 3 个即可晋级到
#                 下一个等级rankLeeway 为 0 则要求全部完成
#      rankLeeway: 8
#      # [列表[文本]] 必须完成才能解锁此挑战组的挑战
#      challenges:
#      - 某个挑战名称
# ======================================================================================================================
#    challenges:
#      # [文本] 挑战名称所有挑战名称应为小写
#      defaultchallenge:
#      # [文本] 在 /challenges 中显示的挑战名称（支持大写和颜色代码）
#        name: '&a 默认挑战'
#        # [文本] 玩家执行 /challenges <挑战名> 时看到的描述
#        description:
#        # [onIsland/onPlayer/islandLevel] 定义所需方块/物品应在玩家的背包中
#        # 还是在他们的岛屿上使用 onIsland 时，玩家必须在他岛屿上距离所需方块
#        # 10 格范围内使用 islandLevel 时，'requiredItems' 字段应为所需的岛屿等级
#        # 玩家必须先使用 /island level 来更新他们的等级
#        type: onPlayer
#        ## type: islandLevel
#        ## type: onIsland
#        # [整数] 覆盖使用 onIsland 时默认的 10 格半径
#        ## radius: 20
#        # 列表[物品需求] 完成挑战所需的物品
#        requiredItems:
#        - stone:64;+16
#        - cobblestone:64;+16
#        # 列表[方块需求] 完成挑战所需的方块
#        requiredBlocks:
#        - stone:64
#        - cobblestone:64
#        # [true/false] 挑战是否可以重复
#        ## repeatable: true
#        # [整数] 挑战可以完成的最大次数覆盖默认的 repeatLimit
#        #           值为 0 表示无限重复
#        ## repeatLimit: 5
#        # [display-item] 在挑战菜单中为已完成挑战显示的物品
#        displayItem: cobblestone
#        # [整数] 需求物品重置为默认值之前的时间（小时）（覆盖主要和等级默认值）
#        ## resetInHours: 4
#        # [true/false] 完成挑战时取走所需物品
#        ## takeItems: true
#        # 玩家完成挑战获得的奖励
#        reward:
#          # [文本] 奖励描述
#          text: '苔石和一把耐久 1 的铁镐'
#          # [列表[物品奖励]] 完成挑战时给予玩家的物品列表
#          items:
#          - mossy_cobblestone:16
#          - iron_pickaxe[enchantments={levels:{unbreaking:1}}]:1
#          # [权限节点] 完成时授予的权限多个权限用空格分隔
#          ## permission: 'test.permission'
#          # [整数] 完成时给予多少货币（需要经济插件）
#          ## currency: 0
#          # [整数] 完成时给予玩家多少经验
#          ## xp: 0
#          # [列表[文本]] 完成时执行给定的命令前面加上 "op" 或 "console" 以以 OP 身份
#                        或从控制台运行命令示例：
#          # 可能的命令参数有：
#          # {player}     - 玩家名称
#          # {playerName} - 玩家的显示名称
#          # {challenge}  - 挑战名称
#          # {position}   - 玩家的位置
#          # {party}      - 为队伍中的每个成员执行一次命令（替换名称）
#          ## commands:
#          ## - 'op: me are the GOD of things'
#          ## - 'console: give {party} aweseomestuff 32'
#        # 奖励部分，用于奖励玩家完成重复挑战（第一次之后的任何一次）
#        # 结构与 'reward' 部分相同
#        repeatReward:
#          text: '苔石'
#          items:
#          - mossy_cobblestone:16
#
# ======================================================================================================================

# [true/false] 启用挑战命令的使用
allowChallenges: true

# [island/player] 挑战是按玩家还是按岛屿跟踪
challengeSharing: island

# [true/false] 如果为 true，首次完成挑战将广播到整个服务器
broadcastCompletion: true

# [文本] 显示首次完成时的广播文本颜色/格式
broadcastText: '&6'

# [true/false] 如果为 true，更高级别等级的挑战需要先完成较低级别等级的挑战
requirePreviousRank: true

# [整数] 每个等级可以未完成但能晋级到下一个等级的挑战数量例如，如果你有 4 个简单挑战
# 且 rankLeeway 为 1，玩家只需完成 3 个即可晋级到下一个等级
# rankLeeway 为 0 则要求全部完成
rankLeeway: 12

# [整数] 需求物品重置为默认值之前的时间（小时）（仅当在下面的挑战中未指定时）
defaultResetInHours: 20

# [整数] 使用 onIsland 时的默认半径（格）可在下面的挑战中覆盖
radius: 10

# [整数] 默认情况下挑战可以完成的最大次数0 表示无限可在下面的挑战定义中覆盖
repeatLimit: 0

# [颜色代码] 列表中未完成挑战使用的颜色
challengeColor: '&e'

# [颜色代码] 列表中已完成挑战（不可重复）使用的颜色
finishedColor: '&2'

# [颜色代码] 列表中已完成挑战（可重复）使用的颜色
repeatableColor: '&a'

# [true/false] 如果为 true，启用 vault 来处理货币奖励
enableEconomyPlugin: true

# [true/false] 如果为 false，挑战在岛屿创建（或重启）时不会重置
resetChallengesOnCreate: true

# 用于锁定挑战的显示材质（例如，STAINED_GLASS_PANE:14 表示红色玻璃板，或 160:14）
lockedDisplayItem: red_stained_glass_pane

# onIsland 类型挑战锁定时的显示材质
ISLAND:
  lockedDisplayItem: blue_stained_glass_pane

# islandLevel 类型挑战锁定时的显示材质
ISLAND_LEVEL:
  lockedDisplayItem: black_stained_glass_pane

# 是否显示锁定挑战的名称
showLockedChallengeName: true

# 创建你自己的挑战时，你需要
# 取消下面部分的注释，否则默认挑战
# 将在每次服务器重启时重新添加修改
# 默认挑战时保留此设置应该没问题
# merge-ignore:
#  - 'ranks'
#
# ===============================================
# 文件底部可以找到设置你自己的挑战的说明
# ===============================================
ranks:
  Tier1:
    name: '&7菜鸟'
    displayItem: cyan_terracotta
    resetInHours: 20
    challenges:
      cobblestonegenerator:
        name: '&7刷石机'
        description: 从刷石机中采集圆石
        type: onPlayer
        requiredItems:
          - cobblestone:64;+2
        displayItem: cobblestone
        lockedDisplayItem: gray_stained_glass_pane
        resetInHours: 12
        reward:
          text: 3 个皮革，20% 概率获得一本书
          items:
            - leather:3
            - '{p=0.2}book:1'
          currency: 10
          xp: 10
          commands:
            - op:effect give {player} regeneration
        repeatReward:
          text: 1 个皮革，10% 概率获得一本书
          items:
            - leather:1
            - '{p=0.1}book:1'
          currency: 5
          xp: 5
      applecollector:
        name: '&6果农'
        description: 从树上收集苹果
        type: onPlayer
        requiredItems:
          - apple:2;+1
        displayItem: apple
        lockedDisplayItem: brown_stained_glass_pane
        resetInHours: 6
        reward:
          text: 每种树苗各 1 个（深色橡木 4 个）
          items:
            - oak_sapling:1
            - spruce_sapling:1
            - birch_sapling:1
            - jungle_sapling:1
            - acacia_sapling:1
            - dark_oak_sapling:4
            - '{p=0.2}jungle_sapling:3'
          currency: 20
          xp: 20
        repeatReward:
          text: 每种树苗各 1 个（深色橡木 4 个）
          items:
            - oak_sapling:1
            - spruce_sapling:1
            - birch_sapling:1
            - jungle_sapling:1
            - acacia_sapling:1
            - dark_oak_sapling:4
            - '{p=0.1}jungle_sapling:3'
          currency: 10
          xp: 10
      sugarplanter:
        name: '&9甘蔗种植者'
        type: onIsland
        displayItem: sugar_cane
        lockedDisplayItem: brown_stained_glass_pane
        requiredBlocks:
          - sugar_cane:4
        reward:
          text: 4 个泥土
          items:
            - dirt:4
          currency: 20
          xp: 20
      sugarfarmer:
        name: '&6甘蔗农夫'
        description: 从农场收获甘蔗
        type: onPlayer
        requiredItems:
          - sugar_cane:64;+16
        offset: -1
        displayItem: sugar_cane
        lockedDisplayItem: brown_stained_glass_pane
        reward:
          text: 8 个泥土
          items:
            - dirt:8
            - '{p=0.1}bone:1'
          currency: 20
          xp: 20
        repeatReward:
          text: 4 个泥土
          items:
            - dirt:4
            - '{p=0.05}dirt:4'
          currency: 10
          xp: 10
      melonfarmer:
        name: '&6西瓜农夫'
        description: 从农场收获西瓜片
        type: onPlayer
        requiredItems:
          - melon_slice:128;+8
        displayItem: melon
        lockedDisplayItem: brown_stained_glass_pane
        reward:
          text: 8 个泥土
          items:
            - dirt:8
          currency: 20
          xp: 20
        repeatReward:
          text: 4 个泥土
          items:
            - dirt:4
          currency: 10
          xp: 10
      cactusfarmer:
        name: '&6仙人掌农夫'
        description: 从农场收获仙人掌
        type: onPlayer
        requiredItems:
          - cactus:64;+16
        displayItem: cactus
