          currency: 20
          xp: 20
        repeatReward:
          text: 4 个沙子
          items:
            - sand:4
            - '{p=0.1}bone:1'
          currency: 10
          xp: 10
      pumpkinfarmer:
        name: '&6南瓜农夫'
        description: 从农场收获南瓜
        type: onPlayer
        requiredItems:
