        type: islandLevel
        requiredLevel: 250
        displayItem: diamond_ore
        offset: -1
        reward:
          text: 32 个泥土，32 个沙子，4 个钻石，5 个绿宝石
          items:
            - dirt:32
            - sand:32
            - emerald:5
            - diamond:4
